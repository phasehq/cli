{
  "credentialEnvironment": [
    "GH_ENTERPRISE_TOKEN",
    "GH_TOKEN",
    "GITHUB_ENTERPRISE_TOKEN",
    "GITHUB_TOKEN"
  ],
  "secretGuard": {
    "paths": [
      {
        "method": "POST",
